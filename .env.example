# Documentation only. Put real local Worker values in the ignored .dev.vars file.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
GOOGLE_AUTH_READY=false
TOSS_BILLING_MODE=test
TOSS_CLIENT_KEY=YOUR_TEST_CLIENT_KEY
TOSS_SECRET_KEY=YOUR_TEST_SECRET_KEY
BILLING_ENCRYPTION_KEY=YOUR_64_CHARACTER_HEX_KEY
BILLING_SCHEDULER_READY=false
ADSENSE_READY=false
